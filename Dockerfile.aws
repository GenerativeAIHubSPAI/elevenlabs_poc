# ── Stage 1: Build React frontend ─────────────────────────────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .

ARG APP_PREFIX=""
ENV VITE_API_PREFIX=$APP_PREFIX

RUN npm run build

# ── Stage 2: Backend + nginx + supervisor (single container) ───────────────────
FROM python:3.13-slim

# Install nginx and supervisor
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

# ── Python backend ─────────────────────────────────────────────────────────────
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# ── Frontend static files ──────────────────────────────────────────────────────
COPY --from=frontend-builder /frontend/dist /var/www/html

# ── nginx config template ──────────────────────────────────────────────────────
# APP_PREFIX (e.g. /demo5-voice-assistant) is substituted at container start.
# Leave APP_PREFIX empty to serve at root (local dev / direct ECS access).
RUN apt-get update && apt-get install -y --no-install-recommends gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Two nginx config templates: one for prefix mode, one for root mode.
RUN cat > /etc/nginx/sites-available/default-prefix.template <<'EOF'
server {
    listen 80;
    client_max_body_size 25m;

    add_header Cross-Origin-Opener-Policy "same-origin";
    add_header Cross-Origin-Embedder-Policy "require-corp";

    location ~ ^${APP_PREFIX}/(health|stt|tts|kb|chat|voice|docs|openapi.json) {
        rewrite ^${APP_PREFIX}/(.*) /$1 break;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        add_header Access-Control-Expose-Headers "X-Transcript, X-Reply-Text" always;
    }

    # SPA under the prefix → strip prefix → serve files from root
    location ${APP_PREFIX}/ {
        rewrite ^${APP_PREFIX}/(.*)$ /$1 break;
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # ALB and ECS health checks reach the task directly, without the CloudFront
    # prefix: send them to uvicorn so they test the backend, not the static SPA.
    location = /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    # Everything else → SPA, always 200
    location / {
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
EOF

RUN cat > /etc/nginx/sites-available/default-root.conf <<'EOF'
server {
    listen 80;
    client_max_body_size 25m;

    add_header Cross-Origin-Opener-Policy "same-origin";
    add_header Cross-Origin-Embedder-Policy "require-corp";

    location ~ ^/(health|stt|tts|kb|chat|voice|docs|openapi.json) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        add_header Access-Control-Expose-Headers "X-Transcript, X-Reply-Text" always;
    }

    location / {
        root /var/www/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
EOF

# ── Supervisor config ──────────────────────────────────────────────────────────
RUN cat > /etc/supervisor/conf.d/app.conf <<'EOF'
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid

[program:uvicorn]
command=uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
directory=/app
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

; If a program exhausts its restarts, stop the container so ECS replaces the
; task. Otherwise nginx keeps it alive, serving the SPA with no backend.
; stdout is this listener's protocol channel, so only stderr is logged.
[eventlistener:exit_on_fatal]
command=python3 /usr/local/bin/supervisor_exit_on_fatal.py
events=PROCESS_STATE_FATAL
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
EOF

RUN cat > /usr/local/bin/supervisor_exit_on_fatal.py <<'EOF'
import os
import signal
import sys

while True:
    sys.stdout.write("READY\n")
    sys.stdout.flush()

    header = dict(token.split(":", 1) for token in sys.stdin.readline().split())
    payload = sys.stdin.read(int(header["len"]))

    sys.stderr.write(f"Program entered FATAL, stopping the container: {payload}\n")
    sys.stderr.flush()

    sys.stdout.write("RESULT 2\nOK")
    sys.stdout.flush()

    os.kill(os.getppid(), signal.SIGTERM)
EOF

# Container health check: goes through nginx to uvicorn, so it fails if either is
# down. Referenced by the ECS task definition (see deploy_app.yml) -- ECS ignores
# the Dockerfile HEALTHCHECK, which only serves local `docker run`.
RUN cat > /usr/local/bin/healthcheck <<'EOF'
#!/bin/sh
exec python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1/health', timeout=4)"
EOF
RUN chmod +x /usr/local/bin/healthcheck

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD ["/usr/local/bin/healthcheck"]

# Startup script: pick the right nginx config based on APP_PREFIX
RUN cat > /entrypoint.sh <<'EOF'
#!/bin/sh
# Normalize: drop any trailing slash so /demo5-x/ and /demo5-x behave the same
APP_PREFIX="${APP_PREFIX%/}"
if [ -n "${APP_PREFIX}" ]; then
    APP_PREFIX="${APP_PREFIX}" envsubst '${APP_PREFIX}' \
        < /etc/nginx/sites-available/default-prefix.template \
        > /etc/nginx/sites-available/default
else
    cp /etc/nginx/sites-available/default-root.conf \
       /etc/nginx/sites-available/default
fi
exec /usr/bin/supervisord -c /etc/supervisor/supervisord.conf
EOF
RUN chmod +x /entrypoint.sh

EXPOSE 80

CMD ["/entrypoint.sh"]
